# Copie para .env somente se quiser mudar algum padrao: o compose sobe sem .env.
# Nunca coloque segredo real neste arquivo.
# Os valores abaixo sao os padroes do compose local.

# --- gateway
JWT_SEGREDO=segredo-apenas-do-compose-local-troque-em-producao
JWT_EXPIRA_MIN=60
USUARIO_DEMO=aluno
SENHA_DEMO=senha-local-do-compose
LIMITE_POR_MINUTO=60
# origem do IP do cliente atras de proxy (rate limit do login): nome de um cabecalho que o
# proxy sobrescreve, ou quantos proxies confiaveis acrescentam ao X-Forwarded-For
CABECALHO_IP_CLIENTE=
PROXIES_CONFIAVEIS=0
# acorda os servicos que dormem no plano gratuito
DESPERTAR_SERVICOS=1
DESPERTAR_INTERVALO=30
DESPERTAR_TIMEOUT=90

# --- comunicacao entre servicos
TOKEN_INTERNO=token-interno-apenas-do-compose-local
# Enderecos: o compose os fixa pelos nomes dos servicos (descoberta de servicos); as quatro
# variaveis abaixo so valem fora dele (por exemplo, no Render)
URL_INFERENCIA=http://inferencia:8001
URL_WORKER=http://worker:8002
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:postgres@vetorial:5432/plataforma
# senha do container do banco local (usada tambem na DATABASE_URL padrao)
POSTGRES_PASSWORD=postgres

# --- limites de entrada (iguais no gateway e na inferencia)
TEXTO_MAXIMO=5000
TOP_K=3

# --- tempo-limite e resiliencia
TIMEOUT_CONEXAO=5
TIMEOUT_INFERENCIA=10
# teto somando as retentativas (vazio = 1,5 x TIMEOUT_INFERENCIA)
PRAZO_INFERENCIA=
REDIS_TIMEOUT=5
REDIS_TIMEOUT_CONEXAO=3
DB_TIMEOUT=5
DB_POOL_MAXIMO=3
RETENTATIVAS=3
BACKOFF_BASE=0.5
ESPERA_MAXIMA=30
LIMITE_FALHAS=3
ESPERA_DISJUNTOR=20
MAX_TENTATIVAS=3
# segundos que uma tarefa pode passar por falhas transitorias antes da dead-letter
TAREFA_IDADE_MAXIMA=900

# --- dados e retencao (LGPD)
# documentos no banco (dias)
RETENCAO_DIAS=30
# dead-letter, que contem o texto (dias)
DLQ_RETENCAO_DIAS=7
# estado da tarefa e mensagens na fila (segundos)
TAREFA_VALIDADE=86400
# frequencia do expurgo no worker (segundos)
INTERVALO_EXPURGO=3600

# --- LLM (vazio = modo simulado, offline)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
LLM_TIMEOUT=5
# teto somando as retentativas; DB_TIMEOUT + LLM_PRAZO_TOTAL < TIMEOUT_INFERENCIA
LLM_PRAZO_TOTAL=4

# --- observabilidade (OTEL_SERVICE_NAME e definido por servico no compose/render)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_HEADERS=
NIVEL_LOG=INFO

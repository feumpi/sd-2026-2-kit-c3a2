# Copie para .env somente se quiser mudar algum padrao: o compose deve subir sem .env.
# Nunca coloque segredo real neste arquivo.
# Estas sao as variaveis planejadas; mantenha a lista igual ao que o codigo le.

# --- gateway
JWT_SEGREDO=troque-este-segredo-por-um-com-32-bytes-ou-mais
JWT_EXPIRA_MIN=60
USUARIO_DEMO=aluno
SENHA_DEMO=troque-esta-senha
LIMITE_POR_MINUTO=60

# --- comunicacao entre servicos (nomes do compose)
TOKEN_INTERNO=troque-este-token-interno
URL_INFERENCIA=http://inferencia:8001
URL_WORKER=http://worker:8002
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:postgres@vetorial:5432/plataforma

# --- resiliencia
TIMEOUT_INFERENCIA=10
RETENTATIVAS=3
BACKOFF_BASE=0.5
LIMITE_FALHAS=3
ESPERA_DISJUNTOR=20
MAX_TENTATIVAS=3
TAREFA_IDADE_MAXIMA=900

# --- dados (LGPD)
RETENCAO_DIAS=30

# --- LLM (vazio = modo simulado, offline)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
LLM_TIMEOUT=20

# --- observabilidade (OTEL_SERVICE_NAME e definido por servico no compose/render)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_HEADERS=
